{
  "name": "mertmaks-eood",
  "version": "6.0.0",
  "private": true,
  "description": "MERTMAX monorepo with Next.js web app and Sanity Studio",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mertmaks/web",
    "dev:web": "npm run dev --workspace @mertmaks/web",
    "dev:studio": "npm run dev --workspace @mertmaks/studio",
    "build": "npm run build --workspace @mertmaks/web",
    "build:web": "npm run build --workspace @mertmaks/web",
    "build:studio": "npm run build --workspace @mertmaks/studio",
    "start": "npm run start --workspace @mertmaks/web",
    "lint": "npm run lint --workspace @mertmaks/web",
    "typecheck": "npm run typecheck --workspace @mertmaks/web && npm run typecheck --workspace @mertmaks/content",
    "format": "npm run format --workspace @mertmaks/web",
    "test": "npm run test --workspace @mertmaks/web",
    "test:e2e": "npm run test:e2e --workspace @mertmaks/web",
    "compile:scss": "npm run compile:scss --workspace @mertmaks/web",
    "sanity:import": "npm run import:static --workspace @mertmaks/content",
    "sanity:seed-promotions": "npm run seed:promotions --workspace @mertmaks/content"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
