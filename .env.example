# Contact Form Email Configuration
# Uncomment and configure ONE of the following options:

# Option 1: Resend (recommended for Next.js)
# RESEND_API_KEY=re_your_api_key_here

# Option 2: SMTP (e.g., Gmail, SendGrid)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Recipient email for contact form submissions
TO_EMAIL=info@mertmax.bg

# Application Environment
NODE_ENV=development

# Public site URL (used for canonical URLs, sitemap.xml, robots.txt, Open Graph)
NEXT_PUBLIC_SITE_URL=https://mertmax.bg

# Sanity CMS
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_VERSION=2026-05-19
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=your_webhook_secret
SANITY_FETCH_TIMEOUT_MS=10000

# Optional public aliases used by some Next/Sanity deployments.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-19
